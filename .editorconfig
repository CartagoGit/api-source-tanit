# Formato consistente entre editores, independientemente de la
# configuración personal de cada uno.
#
# Los valores salen del código que ya hay, no de una preferencia nueva:
# 2 espacios, 90 columnas y LF son lo que usan los ~170 ficheros del
# repo. Esto solo lo hace explícito para que un editor ajeno no lo
# rompa en el primer guardado.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 90

# Los fixtures son código de OTROS proyectos: se dejan como se
# escribirían en su ecosistema.
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false

[tests/smoke-fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{go,java,cs}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 88

[*.php]
indent_size = 4

[*.md]
# En Markdown dos espacios al final son un salto de línea deliberado.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
