{
  // Opciones comunes a todas las secciones. Ninguna sección las
  // relaja: si algo no compila con esto, es que hay que arreglarlo,
  // no que hay que bajar el listón para esa carpeta.
  //
  // `types: []` es deliberado. El paquete no depende de `@types/node`
  // ni de `@types/bun`: las declaraciones ambient que necesita están
  // escritas a mano en `contracts/postman.d.ts`. Así el binario
  // compilado no arrastra tipos de un runtime que puede no estar.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": []
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    // Los fixtures son código de ejemplo de OTROS proyectos: NestJS con
    // decoradores, Express con handlers sin tipar. Son la entrada de
    // los scanners, no código de este repo, y no tienen sus frameworks
    // instalados. Tiparlos daría 89 errores que no significan nada.
    "tests/fixtures",
    "tests/smoke-fixtures"
  ]
}
