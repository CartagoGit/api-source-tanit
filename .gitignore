# Dependencias instaladas localmente por bun/npm (si se llegasen a usar).
node_modules/
.bun/
# Artefactos generados: colecciones y environments. La carpeta se llama
# como el proyecto a proposito — `build/` es de Gradle, de Go y de medio
# mundo, y escribir ahi mezclaba nuestra salida con la de quien usa la
# herramienta.
export-to-postman/
build/

*.log

# El lockfile SI se versiona: es lo que hace que un `bun install` en CI
# o en otra maquina resuelva exactamente las mismas versiones. Solo el
# binario legacy se queda fuera.
bun.lockb

# Cache local de mcp-vertex
.cache/
# Binarios compilados por `bun run build:binary`.
dist/

# El sidecar que Tauri empaqueta: se compila en cada build y pesa 90 MB.
projects/desktop/binaries/
projects/desktop/target/
