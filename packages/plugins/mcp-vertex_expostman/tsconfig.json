{
  // Tipado de lo que se PUBLICA: solo `src/`.
  //
  // Es lo que acaba en `dist/` y lo que consume mcp-vertex, así que
  // aquí no entran los tests: sus tipos (`vitest`, helpers, dobles) no
  // deben poder colarse en el paquete publicado. Para los tests está
  // `tsconfig.test.json`, y `bun run typecheck` corre los dos.
  //
  // El plugin es un proyecto independiente y NO extiende del tsconfig
  // del CLI: aquel declara `types: []` y sus propias declaraciones
  // ambient de node, mientras que aquí sí usamos `@types/node` y
  // `@types/bun` porque es lo que hace el resto de plugins de
  // mcp-vertex. Mezclarlos hacía chocar `spawnSync` y `Bun`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // `noUncheckedIndexedAccess` sí: p00043 la activó en todo el repo y
    // arregló los 24 sitios que destapó, así que el código del CLI que
    // entra en este programa ya la cumple.
    "noUncheckedIndexedAccess": true,
    // `noUnusedLocals` NO, y no por nuestro código.
    //
    // `customConditions: ["@mcp-vertex/source"]` hace que
    // `@mcp-vertex/core` resuelva a su **código fuente** en vez de a sus
    // declaraciones — que es lo que queremos, porque así el plugin se
    // entera si el core cambia de forma. El precio es que sus ficheros
    // entran en este programa y heredan estas reglas: activar
    // `noUnusedLocals` produce 3 errores en `assemble-plugins.ts` y
    // `wire-plugin.ts`, de otro repositorio, que no son nuestros para
    // arreglar. `skipLibCheck` no los tapa porque son `.ts`, no `.d.ts`.
    //
    // Ver p00027 S4: la ruta relativa a `packages/` NO era la causa, y
    // sustituirla por una dependencia de paquete resultó peor (Bun copia
    // los `file:`, así que el plugin tiparía contra una foto congelada
    // del repo hasta el siguiente `bun install`).
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "customConditions": ["@mcp-vertex/source"],
    // `noEmit` con `declaration` era contradictorio: pedía generar los
    // .d.ts y a la vez no escribir nada. El build de verdad lo hace
    // `bun run build`; este proyecto solo comprueba tipos.
    "noEmit": true,
    "types": ["node", "bun"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
