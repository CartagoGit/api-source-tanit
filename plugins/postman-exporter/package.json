{
  "name": "@postman-exporter/mcp-vertex-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Plugin MCP-vertex para el proyecto postman-exporter. Genera, valida e inspecciona colecciones Postman v2.1.0 desde rutas Laravel de cualquier proyecto host.",
  "author": "Cartago",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-vertex",
    "plugin",
    "postman",
    "laravel",
    "api",
    "collection",
    "agent",
    "ai"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "@mcp-vertex/source": {
        "types": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@mcp-vertex/core": "file:../../../mcp-vertex/packages/core",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
