{
  "name": "@postman-exporter/mcp-vertex-testing-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Plugin MCP-vertex para validar la salud del paquete postman-exporter (typecheck, build, check, test). Pensado para que un agente pregunte '¿está sano este paquete?' con un solo tool call.",
  "author": "Cartago",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-vertex",
    "plugin",
    "postman",
    "laravel",
    "testing",
    "health-check",
    "validation",
    "agent",
    "ai"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "@mcp-vertex/source": {
        "types": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@mcp-vertex/core": "file:../../../mcp-vertex/packages/core",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
