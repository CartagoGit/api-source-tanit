{
  "coreVersion": "0.1.0",
  "cacheDir": ".cache/mcp-vertex",
  "docsDir": "docs/mcp-vertex",
  "convention": {
    "pluginPathsRoot": "plugins",
    "sourceRoot": "plugins"
  },
  "plugins": {
    "git": {
      "options": {
        "allowForge": true
      }
    },
    "search": {
      "options": {
        "roots": [
          "projects",
          "scripts",
          "tests",
          "docs",
          "examples"
        ],
        "extensions": [
          "ts",
          "tsx",
          "js",
          "mjs",
          "cjs",
          "md",
          "mdx",
          "json"
        ],
        "ignoreDirs": [
          "node_modules",
          ".cache",
          "dist",
          "build",
          ".git"
        ]
      }
    },
    "memory": {
      "options": {
        "bm25K1": 1.5,
        "bm25B": 0.75,
        "titleWeight": 2,
        "maxNotes": 1000
      }
    },
    "docs": {
      "options": {
        "roots": [
          "docs/mcp-vertex",
          "README.md",
          "projects/plugins/mcp-vertex_expostman/README.md"
        ],
        "extensions": [
          "md",
          "mdx"
        ],
        "ignoreDirs": [
          "node_modules",
          ".cache",
          "dist"
        ]
      }
    },
    "rules": {
      "options": {}
    },
    "quality": {
      "options": {}
    },
    "conventions": {
      "options": {
        "roots": [
          "projects",
          "scripts",
          "tests",
          "docs",
          "examples"
        ]
      }
    },
    "proposals": {
      "options": {
        "validationCommand": "bun run validate",
        "namePool": [
          "falcon",
          "owl",
          "crow",
          "sparrow",
          "finch"
        ],
        "orchestration": {
          "delegateAfterToolCalls": 3
        }
      }
    },
    "auto-agent-selector": {
      "options": {
        "costQualityTradeoff": 8
      }
    },
    "auto-plugin-selector": {
      "options": {}
    },
    "cache": {
      "options": {
        "maxAgeDays": 30,
        "worktrees": {
          "enabled": true,
          "keepLastN": 3
        }
      }
    },
    "deps": {
      "options": {
        "manifest": "package.json",
        "allowNetwork": false,
        "allowWrite": false
      }
    },
    "env": {
      "options": {}
    },
    "diagram": {
      "options": {}
    },
    "perf": {
      "options": {}
    },
    "security": {
      "options": {}
    },
    "tech-debt": {
      "options": {}
    },
    "link-check": {
      "options": {}
    },
    "audit": {
      "options": {
        "auditDir": "docs/mcp-vertex/proposals/ready",
        "topActions": 5,
        "layers": []
      }
    },
    "changelog": {
      "options": {}
    },
    "issues": {
      "options": {
        "scaffoldDir": "docs/mcp-vertex/proposals/retired/issues"
      }
    },
    "refactor": {
      "options": {}
    },
    "forge": {
      "options": {}
    },
    "web-fetch": {
      "options": {
        "allowList": []
      }
    },
    "skills-pack": {
      "options": {}
    },
    "prompts-pack": {
      "options": {}
    },
    "i18n": {
      "options": {}
    },
    "test-convention": {
      "options": {}
    },
    "test-policy": {
      "options": {}
    },
    "container": {
      "options": {}
    },
    "api": {
      "options": {}
    },
    "browser": {
      "options": {}
    },
    "observability": {
      "options": {}
    },
    "usage-tracking": {
      "options": {}
    },
    "orchestrator-runner": {
      "options": {}
    },
    "prompt-eval": {
      "options": {}
    },
    "expostman": {
      "path": "projects/plugins/mcp-vertex_expostman/src/index.ts",
      "options": {
        "defaultProjectRoot": "${workspaceFolder}/..",
        "cliScript": "${workspaceFolder}/projects/cli/cli.script.ts"
      }
    }
  }
}
