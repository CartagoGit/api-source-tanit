{
  "name": "export-to-postman",
  "version": "0.1.0",
  "workspaces": [
    "projects/plugins/mcp-vertex_expostman"
  ],
  "description": "Generador agnóstico de colecciones Postman v2.1.0 desde las rutas de cualquier proyecto de API. Detecta el framework automáticamente (Laravel, Symfony, Express, NestJS, FastAPI, Flask, Django, Next.js, Gin, Spring Boot, ASP.NET y OpenAPI) y extrae endpoints, bodies y parámetros sin configuración manual.",
  "keywords": [
    "postman",
    "laravel",
    "api",
    "collection",
    "generator",
    "openapi",
    "testing",
    "devtools",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "author": "Cartago",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CartagoGit/export-to-postman.git"
  },
  "homepage": "https://github.com/CartagoGit/export-to-postman#readme",
  "bugs": {
    "url": "https://github.com/CartagoGit/export-to-postman/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "bin": {
    "expostman": "./projects/cli/cli.script.ts",
    "export-to-postman": "./projects/cli/cli.script.ts"
  },
  "main": "./projects/cli/cli.script.ts",
  "module": "./projects/cli/cli.script.ts",
  "exports": {
    ".": "./projects/cli/cli.script.ts",
    "./core/*": "./projects/core/*",
    "./frameworks": "./projects/frameworks/index.ts"
  },
  "files": [
    "bin/",
    "projects/",
    "scripts/",
    "docs/INSTALL.md",
    "docs/FRAMEWORKS.md",
    "docs/POSTMAN.md",
    "tsconfig.json",
    "tsconfig.base.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run projects/cli/commands/generate.script.ts --project-root ./examples/example-express",
    "check": "bun run projects/cli/commands/diff.script.ts --project-root ./examples/example-express && bun run projects/cli/commands/validate-json.script.ts --project-root ./examples/example-express",
    "typecheck": "bun run scripts/gates/typecheck.script.ts",
    "list": "bun run projects/cli/commands/list-endpoints.script.ts",
    "stats": "bun run projects/cli/commands/stats.script.ts",
    "scan": "bun run projects/cli/commands/scan.script.ts",
    "ui": "bun run projects/cli/commands/ui.script.ts",
    "open": "bun run projects/cli/commands/open-postman.script.ts",
    "init": "bun run projects/cli/commands/init.script.ts",
    "clean": "rm -f build/*.json",
    "test": "bunx vitest run",
    "lint:tools": "bun run scripts/gates/lint-tool-no-process.script.ts",
    "validate:examples": "bun run scripts/gates/validate.script.ts",
    "validate": "bun run typecheck && bun run lint && bun run test && bun run validate:examples",
    "validate:package": "bun run scripts/gates/validate-package.script.ts",
    "build:binary": "bun run scripts/build/build-binary.script.ts",
    "push": "bun run projects/cli/commands/push.script.ts",
    "lint:proposals": "bun run scripts/gates/lint-proposals.script.ts",
    "test:watch": "bunx vitest",
    "test:contracts": "bunx vitest run --project contracts",
    "test:core": "bunx vitest run --project core",
    "test:frameworks": "bunx vitest run --project frameworks",
    "test:cli": "bunx vitest run --project cli",
    "test:e2e": "bunx vitest run --project e2e",
    "test:plugin": "bunx vitest run --project plugin",
    "test:coverage": "bunx vitest run --coverage",
    "test:changed": "bun run scripts/gates/changed.script.ts",
    "typecheck:contracts": "bun run scripts/gates/typecheck.script.ts contracts",
    "typecheck:core": "bun run scripts/gates/typecheck.script.ts core",
    "typecheck:frameworks": "bun run scripts/gates/typecheck.script.ts frameworks",
    "typecheck:cli": "bun run scripts/gates/typecheck.script.ts cli",
    "typecheck:plugin": "bun run --cwd projects/plugins/mcp-vertex_expostman typecheck",
    "lint:boundaries": "bun run scripts/gates/lint-boundaries.script.ts",
    "lint": "bun run lint:naming && bun run lint:paths && bun run lint:regex-state && bun run lint:tools && bun run lint:boundaries && bun run lint:mcp && bun run lint:docs && bun run lint:proposals && bun run lint:secrets && bun run lint:sast && bun run lint:tsdoc && bun run lint:api && bun run lint:frameworks-table && bun run lint:mcp-surface && bun run lint:durable-writes && bun run lint:bootstrap-drift && bun run lint:no-type-escapes && bun run lint:command-coverage && bun run lint:project-context",
    "lint:naming": "bun run scripts/gates/lint-naming.script.ts",
    "mcp:sync": "bun run scripts/gates/sync-mcp-config.script.ts",
    "lint:command-coverage": "bun run scripts/gates/lint-command-coverage.script.ts",
    "lint:no-type-escapes": "bun run scripts/gates/lint-no-type-escapes.script.ts",
    "lint:bootstrap-drift": "bun run scripts/gates/lint-bootstrap-drift.script.ts",
    "lint:durable-writes": "bun run scripts/gates/lint-durable-writes.script.ts",
    "lint:mcp-surface": "bun run scripts/gates/lint-mcp-surface.script.ts",
    "lint:mcp": "bun run scripts/gates/sync-mcp-config.script.ts --check",
    "lint:paths": "bun run scripts/gates/lint-paths.script.ts",
    "lint:docs": "bun run scripts/gates/lint-docs.script.ts",
    "lint:project-context": "bun run scripts/gates/lint-project-context.script.ts",
    "lint:regex-state": "bun run scripts/gates/lint-regex-state.script.ts",
    "desktop:build": "bun run scripts/build/desktop-build.script.ts",
    "docker:validate": "docker compose -f .docker/docker-compose.yml run --rm validate",
    "docker:binaries": "docker compose -f .docker/docker-compose.yml run --rm binaries",
    "docker:installers": "docker compose -f .docker/docker-compose.yml run --rm installers",
    "docker:smoke": "docker compose -f .docker/docker-compose.yml run --rm smoke",
    "docker:shell": "docker compose -f .docker/docker-compose.yml run --rm --entrypoint bash shell",
    "bench:scan": "bun run scripts/gates/bench-scan.script.ts",
    "bench:check": "bun run scripts/gates/bench-scan.script.ts --check",
    "lint:secrets": "bun run scripts/gates/lint-secrets.script.ts",
    "lint:sast": "bun run scripts/gates/lint-sast.script.ts",
    "security:audit": "bun audit --audit-level=high",
    "lint:tsdoc": "bun run scripts/gates/lint-tsdoc.script.ts",
    "changelog": "bun run scripts/build/changelog.script.ts",
    "docs:api": "bun run scripts/build/api-reference.script.ts",
    "lint:api": "bun run scripts/build/api-reference.script.ts --check",
    "docs:frameworks": "bun run scripts/build/frameworks-table.script.ts",
    "lint:frameworks-table": "bun run scripts/build/frameworks-table.script.ts --check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "undici": "^7.29.0",
    "hono": "^4.12.34"
  }
}
