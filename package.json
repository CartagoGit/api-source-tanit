{
  "name": "export-to-postman",
  "version": "0.1.0",
  "workspaces": [
    "plugins/*"
  ],
  "description": "Generador agnóstico de colecciones Postman v2.1.0 desde las rutas de cualquier proyecto de API. Detecta el framework automáticamente (Laravel, Symfony, Express, NestJS, FastAPI, Flask, Django, Next.js, Gin, Spring Boot, ASP.NET y OpenAPI) y extrae endpoints, bodies y parámetros sin configuración manual.",
  "keywords": [
    "postman",
    "laravel",
    "api",
    "collection",
    "generator",
    "openapi",
    "testing",
    "devtools",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "author": "Cartago",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CartagoGit/export-to-postman.git"
  },
  "homepage": "https://github.com/CartagoGit/export-to-postman#readme",
  "bugs": {
    "url": "https://github.com/CartagoGit/export-to-postman/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "bin": {
    "expostman": "./scripts/cli.script.ts",
    "postman-from-routes": "./scripts/cli.script.ts"
  },
  "main": "./scripts/cli.script.ts",
  "module": "./scripts/cli.script.ts",
  "exports": {
    ".": "./scripts/cli.script.ts",
    "./services/*": "./services/*.service.ts",
    "./contracts/*": "./contracts/*.interface.ts",
    "./helpers/*": "./helpers/*.helper.ts",
    "./frameworks": "./frameworks/index.ts"
  },
  "files": [
    "contracts/",
    "services/",
    "helpers/",
    "frameworks/",
    "scripts/",
    "docs/INSTALL.md",
    "docs/FRAMEWORKS.md",
    "docs/POSTMAN.md",
    "tsconfig.json",
    "tsconfig.base.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/generate.script.ts --project-root ./examples/example-express",
    "check": "bun run scripts/diff.script.ts --project-root ./examples/example-express && bun run scripts/validate-json.script.ts --project-root ./examples/example-express",
    "typecheck": "bun run scripts/gates/typecheck.script.ts",
    "enrich": "bun run scripts/enrich.script.ts",
    "list": "bun run scripts/list-endpoints.script.ts",
    "stats": "bun run scripts/stats.script.ts",
    "scan": "bun run scripts/scan.script.ts",
    "open": "bun run scripts/open-postman.script.ts",
    "init": "bun run scripts/init.script.ts",
    "clean": "rm -f build/*.json",
    "test": "bunx vitest run",
    "lint:tools": "bun run scripts/lint-tool-no-process.script.ts",
    "validate:examples": "bun run scripts/validate.script.ts",
    "validate": "bun run typecheck && bun run lint && bun run test && bun run validate:examples",
    "validate:package": "bun run scripts/validate-package.script.ts",
    "build:binary": "bun run scripts/build-binary.script.ts",
    "push": "bun run scripts/push.script.ts",
    "lint:proposals": "bun run scripts/lint-proposals.script.ts",
    "test:watch": "bunx vitest",
    "test:core": "bunx vitest run --project core",
    "test:frameworks": "bunx vitest run --project frameworks",
    "test:cli": "bunx vitest run --project cli",
    "test:e2e": "bunx vitest run --project e2e",
    "test:plugin": "bunx vitest run --project plugin",
    "test:changed": "bun run scripts/gates/changed.script.ts",
    "typecheck:core": "bun run scripts/gates/typecheck.script.ts core",
    "typecheck:frameworks": "bun run scripts/gates/typecheck.script.ts frameworks",
    "typecheck:cli": "bun run scripts/gates/typecheck.script.ts cli",
    "typecheck:plugin": "bun run --cwd plugins/postman-exporter typecheck",
    "lint:boundaries": "bun run scripts/gates/lint-boundaries.script.ts",
    "lint": "bun run lint:naming && bun run lint:tools && bun run lint:boundaries && bun run lint:proposals",
    "lint:naming": "bun run scripts/gates/lint-naming.script.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "undici": "^7.29.0",
    "hono": "^4.12.34"
  }
}
