{
  "name": "api-source-tanit",
  "version": "1.0.0",
  "workspaces": [
    "packages/plugins/delendai_tanit"
  ],
  "description": "Tanit — API Source Discovery. Detects your API from source code across 21 frameworks and exports to Postman, Insomnia, Bruno, HAR, OpenAPI, cURL.",
  "keywords": [
    "tanit",
    "api-source",
    "discovery",
    "source-code-analysis",
    "postman",
    "laravel",
    "api",
    "collection",
    "generator",
    "openapi",
    "testing",
    "devtools",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "author": "Cartago",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CartagoGit/api-source-tanit.git"
  },
  "homepage": "https://github.com/CartagoGit/api-source-tanit",
  "bugs": {
    "url": "https://github.com/CartagoGit/api-source-tanit/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "bin": {
    "apisrc": "./bin/apisrc"
  },
  "main": "./packages/cli/cli.script.ts",
  "module": "./packages/cli/cli.script.ts",
  "exports": {
    ".": "./packages/cli/cli.script.ts",
    "./core/*": "./packages/core/*",
    "./frameworks": "./packages/frameworks/index.ts"
  },
  "files": [
    "bin/",
    "packages/",
    "!packages/plugins/delendai_tanit/",
    "scripts/",
    "docs/INSTALL.md",
    "docs/FRAMEWORKS.md",
    "docs/POSTMAN.md",
    "tsconfig.json",
    "tsconfig.base.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run packages/cli/commands/generate.script.ts --project-root ./examples/example-express",
    "check": "bun run packages/cli/commands/diff.script.ts --project-root ./examples/example-express && bun run packages/cli/commands/validate-json.script.ts --project-root ./examples/example-express",
    "typecheck": "bun run scripts/gates/typecheck.script.ts",
    "list": "bun run packages/cli/commands/list-endpoints.script.ts",
    "stats": "bun run packages/cli/commands/stats.script.ts",
    "scan": "bun run packages/cli/commands/scan.script.ts",
    "ui": "bun run packages/cli/commands/ui.script.ts",
    "ui:dev": "bun run scripts/build/ui-dev.script.ts",
    "open": "bun run packages/cli/commands/open-postman.script.ts",
    "init": "bun run packages/cli/commands/init.script.ts",
    "clean": "rm -f build/*.json",
    "test": "bunx vitest run",
    "lint:tools": "bun run scripts/gates/lint-tool-no-process.script.ts",
    "lint:bun-ci": "bun run scripts/gates/lint-bun-ci.script.ts",
    "lint:scanner-state-isolation": "bun run scripts/gates/lint-scanner-state.script.ts",
    "lint:effective-project-root": "bun run scripts/gates/lint-effective-project-root.script.ts",
    "validate:examples": "bun run scripts/gates/validate.script.ts",
    "validate": "bun run typecheck && bun run lint && bun run test:coverage && bun run validate:examples && bun run bench:check",
    "validate:package": "bun run scripts/gates/validate-package.script.ts",
    "build:binary": "bun run scripts/build/build-binary.script.ts",
    "push": "bun run packages/cli/commands/push.script.ts",
    "lint:proposals": "bun run scripts/gates/lint-proposals.script.ts",
    "test:watch": "bunx vitest",
    "test:contracts": "bunx vitest run --project contracts",
    "test:core": "bunx vitest run --project core",
    "test:frameworks": "bunx vitest run --project frameworks",
    "test:cli": "bunx vitest run --project cli",
    "test:e2e": "bunx vitest run --project e2e",
    "test:plugin": "bunx vitest run --project plugin",
    "test:coverage": "bunx vitest run --coverage",
    "test:changed": "bun run scripts/gates/changed.script.ts",
    "typecheck:contracts": "bun run scripts/gates/typecheck.script.ts contracts",
    "typecheck:core": "bun run scripts/gates/typecheck.script.ts core",
    "typecheck:frameworks": "bun run scripts/gates/typecheck.script.ts frameworks",
    "typecheck:cli": "bun run scripts/gates/typecheck.script.ts cli",
    "typecheck:plugin": "bun run --cwd packages/plugins/delendai_tanit typecheck",
    "lint:boundaries": "bun run scripts/gates/lint-boundaries.script.ts",
    "lint": "bun run lint:naming && bun run lint:paths && bun run lint:path-containment && bun run lint:regex-state && bun run lint:no-instance-mutable-maps-in-scanners && bun run lint:scanner-state-isolation && bun run lint:effective-project-root && bun run lint:tools && bun run lint:bun-ci && bun run lint:boundaries && bun run lint:mcp && bun run lint:docs && bun run lint:proposals && bun run lint:secrets && bun run lint:sast && bun run lint:tsdoc && bun run lint:api && bun run lint:frameworks-table && bun run lint:mcp-surface && bun run lint:durable-writes && bun run lint:bootstrap-drift && bun run lint:no-type-escapes && bun run lint:no-raw-json-parse && bun run lint:command-coverage && bun run lint:project-context && bun run lint:contracts && bun run lint:output-language && bun run lint:i18n-completeness",
    "lint:naming": "bun run scripts/gates/lint-naming.script.ts",
    "mcp:sync": "bun run scripts/gates/sync-mcp-config.script.ts",
    "lint:command-coverage": "bun run scripts/gates/lint-command-coverage.script.ts",
    "lint:no-type-escapes": "bun run scripts/gates/lint-no-type-escapes.script.ts",
    "lint:no-raw-json-parse": "bun run scripts/gates/lint-no-raw-json-parse.script.ts",
    "lint:bootstrap-drift": "bun run scripts/gates/lint-bootstrap-drift.script.ts",
    "lint:durable-writes": "bun run scripts/gates/lint-durable-writes.script.ts",
    "lint:mcp-surface": "bun run scripts/gates/lint-mcp-surface.script.ts",
    "lint:mcp": "bun run scripts/gates/sync-mcp-config.script.ts --check",
    "lint:paths": "bun run scripts/gates/lint-paths.script.ts",
    "lint:path-containment": "bun run scripts/gates/lint-path-containment.script.ts",
    "lint:docs": "bun run scripts/gates/lint-docs.script.ts",
    "lint:output-language": "bun run scripts/gates/lint-output-language.script.ts",
    "lint:contracts": "bun run scripts/gates/lint-contracts.script.ts",
    "lint:project-context": "bun run scripts/gates/lint-project-context.script.ts",
    "lint:regex-state": "bun run scripts/gates/lint-regex-state.script.ts",
    "lint:no-instance-mutable-maps-in-scanners": "bun run scripts/gates/lint-no-instance-mutable-maps-in-scanners.script.ts",
    "lint:scanners": "bun run lint:no-instance-mutable-maps-in-scanners",
    "lint:i18n-completeness": "bun run scripts/gates/lint-i18n-completeness.script.ts",
    "desktop:build": "bun run scripts/build/desktop-build.script.ts",
    "desktop:build:linux": "bun run scripts/build/desktop-build.script.ts --platform linux",
    "desktop:build:mac": "bun run scripts/build/desktop-build.script.ts --platform mac",
    "desktop:build:windows": "bun run scripts/build/desktop-build.script.ts --platform windows",
    "docker:validate": "docker compose -f .docker/docker-compose.yml run --rm validate",
    "docker:binaries": "docker compose -f .docker/docker-compose.yml run --rm binaries",
    "docker:installers": "docker compose -f .docker/docker-compose.yml run --rm installers",
    "docker:smoke": "docker compose -f .docker/docker-compose.yml run --rm smoke",
    "docker:shell": "docker compose -f .docker/docker-compose.yml run --rm --entrypoint bash shell",
    "bench:scan": "bun run scripts/gates/bench-scan.script.ts",
    "bench:check": "bun run scripts/gates/bench-scan.script.ts --check",
    "lint:secrets": "bun run scripts/gates/lint-secrets.script.ts",
    "lint:sast": "bun run scripts/gates/lint-sast.script.ts",
    "security:audit": "bun audit --audit-level=high",
    "lint:tsdoc": "bun run scripts/gates/lint-tsdoc.script.ts",
    "changelog": "bun run scripts/build/changelog.script.ts",
    "docs:api": "bun run scripts/build/api-reference.script.ts",
    "lint:api": "bun run scripts/build/api-reference.script.ts --check",
    "docs:frameworks": "bun run scripts/build/frameworks-table.script.ts",
    "lint:frameworks-table": "bun run scripts/build/frameworks-table.script.ts --check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@babel/parser": "7.29.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "nanoid": "^3.3.18",
    "undici": "^7.29.0",
    "hono": "^4.12.34"
  }
}
