{
  "servers": {
    "DelendAI:Tanit": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/integrations/delendai-runtime.sh",
        "__serve",
        "--workspace=${workspaceFolder}",
        "--config=${workspaceFolder}/delendai.config.json"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
