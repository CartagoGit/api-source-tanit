{
  "servers": {
    "DelendAI:Tanit": {
      "type": "stdio",
      "command": "delendai",
      "args": [
        "__serve",
        "--workspace=${workspaceFolder}",
        "--config=${workspaceFolder}/delendai.config.json",
        "--version=0.3.0"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
