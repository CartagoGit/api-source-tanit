{
  // Sección `frameworks` — los 12 scanners y sus parsers.
  //
  // Incluye el núcleo porque depende de él: la flecha va de aquí hacia
  // `core`, nunca al revés.
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/contracts/**/*.d.ts",
    "packages/core/**/*.ts",
    "packages/core/**/*.d.ts",
    "packages/frameworks/**/*.ts",
    "tests/frameworks/**/*.ts",
    "tests/helpers/**/*.ts"
  ]
}
