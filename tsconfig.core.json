{
  // Sección `core` — el núcleo agnóstico.
  //
  // Que esto compile SOLO con estas carpetas es la prueba de que el
  // núcleo no depende de ningún framework. Si alguien añade un import
  // a `frameworks/` desde `services/`, TypeScript lo arrastra al
  // programa y `lint:boundaries` lo caza.
  "extends": "./tsconfig.base.json",
  "include": [
    "contracts/**/*.ts",
    "contracts/**/*.d.ts",
    "helpers/**/*.ts",
    "services/**/*.ts",
    "tests/core/**/*.ts",
    "tests/helpers/**/*.ts"
  ]
}
