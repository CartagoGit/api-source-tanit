{
  // Sección `core` — el núcleo agnóstico.
  //
  // Que esto compile SOLO con estas carpetas es la prueba de que el
  // núcleo no depende de ningún framework: si alguien añade un import a
  // `projects/frameworks/` desde `projects/core/`, TypeScript lo
  // arrastra al programa y `lint:boundaries` lo caza.
  "extends": "./tsconfig.base.json",
  "include": [
    "projects/contracts/**/*.d.ts",
    "projects/core/**/*.ts",
    "projects/core/**/*.d.ts",
    "tests/core/**/*.ts",
    "tests/helpers/**/*.ts"
  ]
}
