{
  // Sección `cli` — comandos, asistente y gates. Es la raíz de
  // composición, así que ve las dos capas de debajo.
  "extends": "./tsconfig.base.json",
  "include": [
    "contract/**/*.ts",
    "contract/**/*.d.ts",
    "helper/**/*.ts",
    "service/**/*.ts",
    "frameworks/**/*.ts",
    "scripts/**/*.ts",
    "tests/cli/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/helpers/**/*.ts",
    "vitest.config.ts",
    "examples/example-app/**/*.ts"
  ]
}
