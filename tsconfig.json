{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": []
  },
  "include": [
    "contract/**/*.ts",
    "contract/**/*.d.ts",
    "service/**/*.ts",
    "helper/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "examples/example-app/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "tests/fixtures",
    "tests/smoke-fixtures"
  ]
}
